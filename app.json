{
  "expo": {
    "name": "Snooze",
    "slug": "snooze",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "snooze-dev",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.snooze.foundation"
    },
    "android": {
      "package": "dev.snooze.foundation"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Snooze to use Face ID to confirm deletion of device data."
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Snooze to use your location to calculate sunrise and sunset for your sleep overview."
        }
      ],
      "expo-font"
    ]
  }
}
